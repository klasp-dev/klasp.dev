---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="klasp — block AI agents on the same gates as your humans"
  description="klasp gates AI coding agents locally on your existing quality checks — before the agent's loop closes. v0.4.0: one-command setup with klasp setup."
>
  <header class="nav">
    <div class="container nav-row">
      <a href="/" class="brand">klasp</a>
      <ul class="nav-links">
        <li><a href="https://github.com/klasp-dev/klasp">GitHub</a></li>
        <li><a href="https://github.com/klasp-dev/klasp/blob/main/docs/setup.md">Docs</a></li>
        <li><a href="https://github.com/klasp-dev/klasp/releases">Releases</a></li>
      </ul>
    </div>
  </header>

  <main>
    <!-- ── 1. HERO ─────────────────────────────────────── -->
    <section class="hero">
      <div class="container">
        <span class="eyebrow"><span class="dot"></span>v0.4.0 — setup + adopt</span>
        <h1 class="h1">
          AI agents commit broken code.
          <em>klasp stops them locally</em> — before the loop closes.
        </h1>
        <p class="lede">
          klasp blocks AI coding agents on your existing quality gates — no rewrites, no
          migration, just <code>klasp setup</code>.
        </p>
        <p class="sub-lede">From <code>git init</code> to green doctor in one command.</p>
        <div class="cta-row">
          <span class="install-snippet">
            <span class="prompt">$</span><span>cargo install klasp &amp;&amp; klasp setup</span>
          </span>
          <a class="btn-ghost" href="https://github.com/klasp-dev/klasp">
            View on GitHub →
          </a>
        </div>
      </div>
    </section>

    <!-- ── 2. MINI-DEMO ───────────────────────────────── -->
    <section class="section demo-section">
      <div class="container">
        <p class="section-label">Live demo</p>
        <h2 class="section-title">Same agent. Same task. One difference.</h2>

        <div class="demo-grid" id="demoGrid">
          <!-- LEFT: without klasp -->
          <div class="demo-panel demo-panel--bad">
            <div class="demo-panel-header">
              <span class="demo-panel-label demo-label--bad">without klasp</span>
              <span class="demo-panel-pid">agent-session · pid 8821</span>
            </div>
            <div class="demo-panel-body" id="demoLeft"></div>
          </div>

          <!-- RIGHT: with klasp -->
          <div class="demo-panel demo-panel--good">
            <div class="demo-panel-header">
              <span class="demo-panel-label demo-label--good">with klasp</span>
              <span class="demo-panel-pid">agent-session · pid 8822</span>
            </div>
            <div class="demo-panel-body" id="demoRight"></div>
          </div>
        </div>

        <div class="demo-controls">
          <button class="btn-replay" id="replayBtn" type="button">Replay</button>
          <span class="demo-hint">auto-loops every 32 s</span>
        </div>
      </div>
    </section>

    <!-- ── 3. BEFORE / AFTER SUMMARY ─────────────────── -->
    <section class="section">
      <div class="container">
        <p class="section-label">At a glance</p>
        <h2 class="section-title">What changes when you add klasp.</h2>
        <div class="compare-table-wrap">
          <table class="compare-table">
            <thead>
              <tr>
                <th class="col-bad">Without klasp</th>
                <th class="col-good">With klasp</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Agent commits broken code</td>
                <td>klasp blocks the commit</td>
              </tr>
              <tr>
                <td>CI fails 6 min later</td>
                <td>Agent gets structured verdict in &lt;5 s</td>
              </tr>
              <tr>
                <td>Human triages the failure</td>
                <td>Agent self-corrects in the same loop</td>
              </tr>
              <tr>
                <td>Quality gate is enforced <em>after</em> code lands</td>
                <td>Quality gate is enforced <em>before</em> code lands</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ── 4. QUICK INSTALL ───────────────────────────── -->
    <section class="section">
      <div class="container">
        <p class="section-label">Install</p>
        <h2 class="section-title">Pick your package manager.</h2>
        <div class="install-grid">
          <div class="install-card">
            <h4>cargo (rust)</h4>
            <pre><span class="prompt">$ </span>cargo install klasp</pre>
          </div>
          <div class="install-card">
            <h4>npm</h4>
            <pre><span class="prompt">$ </span>npm i -g @klasp/cli</pre>
          </div>
          <div class="install-card">
            <h4>pip (python)</h4>
            <pre><span class="prompt">$ </span>pip install klasp</pre>
          </div>
        </div>
        <div class="setup-callout">
          <span class="setup-callout-label">then</span>
          <span class="install-snippet install-snippet--lg">
            <span class="prompt">$</span><span>klasp setup</span>
          </span>
        </div>
      </div>
    </section>

    <!-- existing sections preserved below ──────────────── -->
    <section class="section">
      <div class="container">
        <p class="section-label">Use case · overnight autonomy</p>
        <h2 class="section-title">Ship while you sleep. Wake up to PRs, not panic.</h2>
        <p class="lede" style="margin-bottom: 32px;">
          Autonomous agents need a deterministic <em>done</em> signal. Without one, an
          overnight run drifts: retry loops, exhausted context, force-pushed broken
          commits. klasp <em>is</em> that signal — every iteration ends in a clean
          pass / fail with structured findings.
        </p>

        <div class="usecase-grid">
          <article class="term term-bad" aria-label="Without klasp">
            <div class="term-header">
              <span class="label">Without klasp</span>
              <span class="pid">overnight-run · pid 4471</span>
            </div>
            <div class="term-body">
              <div class="log"><span class="t">23:42</span><span class="ic-arrow">▸</span><span class="msg">agent: implement <strong>checkout flow</strong></span></div>
              <div class="log"><span class="t">00:15</span><span class="ic-fail">✗</span><span class="msg">tests fail · agent guesses, retries with different approach</span></div>
              <div class="log"><span class="t">01:33</span><span class="ic-fail">✗</span><span class="msg">lint errors · agent rewrites unrelated module</span></div>
              <div class="log"><span class="t">02:50</span><span class="ic-fail">✗</span><span class="msg">stuck in test/lint loop · context window exhausted</span></div>
              <div class="log"><span class="t">04:12</span><span class="ic-fail">✗</span><span class="msg">agent gives up <span class="err">→ force-pushes broken code</span></span></div>
              <hr class="term-divider" />
              <div class="log epic"><span class="t">07:00</span><span class="ic-fail">⨯</span><span class="msg"><strong>main is red. 47 failed CI runs. 6h of compute burned.</strong></span></div>
            </div>
          </article>

          <article class="term term-good" aria-label="With klasp">
            <div class="term-header">
              <span class="label">With klasp</span>
              <span class="pid">overnight-run · pid 4472</span>
            </div>
            <div class="term-body">
              <div class="log"><span class="t">23:42</span><span class="ic-arrow">▸</span><span class="msg">agent: implement <strong>checkout flow</strong></span></div>
              <div class="log"><span class="t">23:58</span><span class="ic-warn">●</span><span class="msg"><span class="gate">klasp:format</span> ✗ → 3 lines · agent fixes</span></div>
              <div class="log"><span class="t">00:14</span><span class="ic-ok">✓</span><span class="msg"><span class="gate">format · lint</span> · agent advances</span></div>
              <div class="log"><span class="t">00:47</span><span class="ic-warn">●</span><span class="msg"><span class="gate">klasp:test</span> ✗ → <code>test_total::charges_tax</code> · agent investigates</span></div>
              <div class="log"><span class="t">01:22</span><span class="ic-ok">✓</span><span class="msg"><span class="gate">all gates</span> · commit · open PR <strong>#142</strong></span></div>
              <div class="log"><span class="t">01:25</span><span class="ic-arrow">▸</span><span class="msg">agent: implement <strong>refund handler</strong></span></div>
              <hr class="term-divider" />
              <div class="log epic"><span class="t">07:00</span><span class="ic-ok">✓</span><span class="msg"><strong>4 clean PRs in your queue. All green CI. Ready to review.</strong></span></div>
            </div>
          </article>
        </div>

        <div class="usecase-why">
          <div class="item">
            <h4>01 — deterministic done</h4>
            <p>
              Exit codes are unambiguous. Agents stop guessing whether they're finished —
              the gate said zero, the gate said one. No drift, no panic loops.
            </p>
          </div>
          <div class="item">
            <h4>02 — structured findings</h4>
            <p>
              When a gate fails, klasp surfaces line-numbered diagnostics from
              <code>cargo</code>, <code>pytest</code>, your linter — so the agent fixes
              the actual error, not a hallucinated symptom.
            </p>
          </div>
          <div class="item">
            <h4>03 — bounded context</h4>
            <p>
              Tight pass / fail loops mean each iteration burns a few hundred tokens, not
              tens of thousands. Overnight runs stay inside their context window.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="section-label">Why klasp</p>
        <h2 class="section-title">One config. Same gates. Both audiences.</h2>
        <div class="why-grid">
          <article class="why-card">
            <h3><span class="num">01</span> Stop bad PRs at the source</h3>
            <p>
              Agents can't merge what they can't pass. klasp wires your existing fmt /
              lint / test commands into deterministic exit-code gates the agent has to
              clear before it commits.
            </p>
          </article>
          <article class="why-card">
            <h3><span class="num">02</span> One config, both audiences</h3>
            <p>
              <code>klasp.toml</code> is the single source of truth. The same gate that
              guards your pre-commit hook guards the agent loop — no second config to
              drift out of sync.
            </p>
          </article>
          <article class="why-card">
            <h3><span class="num">03</span> Three surfaces, plugin protocol for the rest</h3>
            <p>
              First-class for Claude Code, Codex CLI, and Aider. Managed
              <code>.claude/settings.json</code> / <code>AGENTS.md</code> /
              <code>.aider.conf.yml</code> blocks installed idempotently, with
              conflict detection and clean uninstall. New surfaces ship via the
              v0 plugin protocol — fork the reference plugin and you're done.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="section-label">Recipes</p>
        <h2 class="section-title">Typed recipes for the gates you already run.</h2>
        <div class="code-block">
          <div class="code-header">
            <span class="dots"><span></span><span></span><span></span></span>
            <span class="file">klasp.toml</span>
          </div>
          <pre class="code-body"><span class="tok-comment"># fmt — wraps an existing pre-commit hook</span>
<span class="tok-section">[[checks]]</span>
<span class="tok-key">name</span>    = <span class="tok-str">"format"</span>
<span class="tok-key">type</span>    = <span class="tok-str">"pre_commit"</span>
<span class="tok-key">hook_id</span> = <span class="tok-str">"rustfmt"</span>

<span class="tok-comment"># lint — fallow groups multiple checks under one verdict</span>
<span class="tok-section">[[checks]]</span>
<span class="tok-key">name</span> = <span class="tok-str">"lint"</span>
<span class="tok-key">type</span> = <span class="tok-str">"fallow"</span>

<span class="tok-comment"># test — pytest with JUnit-XML diagnostics surfaced to the agent</span>
<span class="tok-section">[[checks]]</span>
<span class="tok-key">name</span>      = <span class="tok-str">"test"</span>
<span class="tok-key">type</span>      = <span class="tok-str">"pytest"</span>
<span class="tok-key">junit_xml</span> = <span class="tok-bool">true</span>

<span class="tok-comment"># build — cargo with structured compiler diagnostics</span>
<span class="tok-section">[[checks]]</span>
<span class="tok-key">name</span>       = <span class="tok-str">"build"</span>
<span class="tok-key">type</span>       = <span class="tok-str">"cargo"</span>
<span class="tok-key">subcommand</span> = <span class="tok-str">"check"</span>
</pre>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="section-label">Agents</p>
        <h2 class="section-title">First-class support for the agents you ship with.</h2>
        <table class="matrix">
          <thead>
            <tr>
              <th class="feature">Capability</th>
              <th>Claude Code</th>
              <th>Codex CLI</th>
              <th>Aider</th>
              <th>Cursor</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="feature">Pre-commit gate</td>
              <td class="yes">✓</td>
              <td class="yes">✓</td>
              <td class="yes">✓</td>
              <td class="pending">—</td>
            </tr>
            <tr>
              <td class="feature">Push gate</td>
              <td class="yes">✓</td>
              <td class="yes">✓</td>
              <td class="pending">—</td>
              <td class="pending">—</td>
            </tr>
            <tr>
              <td class="feature">Managed config</td>
              <td><code>.claude/settings.json</code></td>
              <td><code>AGENTS.md</code></td>
              <td><code>.aider.conf.yml</code></td>
              <td class="pending">—</td>
            </tr>
            <tr>
              <td class="feature">Idempotent install / uninstall</td>
              <td class="yes">✓</td>
              <td class="yes">✓</td>
              <td class="yes">✓</td>
              <td class="pending">—</td>
            </tr>
            <tr>
              <td class="feature">Conflict detection</td>
              <td class="yes">✓</td>
              <td class="yes">✓</td>
              <td class="pending">—</td>
              <td class="pending">—</td>
            </tr>
            <tr>
              <td class="feature">Captured-session test</td>
              <td class="yes">✓</td>
              <td class="yes">✓</td>
              <td class="yes">✓</td>
              <td class="pending">—</td>
            </tr>
          </tbody>
        </table>
        <p class="matrix-note">
          Cursor's hook surface is still beta as of Cursor 3.3 with open
          correctness bugs — deferred to v0.3.x or v1.0. Need a different
          agent? Ship a plugin: see the
          <a href="https://github.com/klasp-dev/klasp/tree/main/examples/klasp-plugin-pre-commit">reference plugin</a>
          and the
          <a href="https://github.com/klasp-dev/klasp/blob/main/docs/plugin-protocol.md">v0 protocol spec</a>.
        </p>
      </div>
    </section>
  </main>

  <!-- ── 5. FOOTER ─────────────────────────────────────── -->
  <footer class="footer">
    <div class="container footer-row">
      <span>klasp · v0.4.0 · Apache-2.0</span>
      <ul class="footer-links">
        <li><a href="https://github.com/klasp-dev/klasp">GitHub</a></li>
        <li><a href="https://github.com/klasp-dev/klasp/blob/main/docs/setup.md">Docs</a></li>
        <li><a href="https://github.com/klasp-dev/klasp/releases/tag/v0.4.0">v0.4.0 release</a></li>
        <li><a href="https://github.com/klasp-dev/klasp/issues">Issues</a></li>
        <li><a href="https://github.com/klasp-dev/klasp/blob/main/LICENSE">License</a></li>
      </ul>
    </div>
  </footer>
</Layout>

<script>
// ── Mini-demo animation ──────────────────────────────────────────
// All timing in milliseconds.
// FRAME = one "typed line" appearance.  Lines are pre-built HTML strings —
// no character-by-character typing to keep the JS under 150 lines.

const LOOP_DELAY = 32_000; // ms before auto-restart

type Frame = { html: string; delay: number };

const leftFrames: Frame[] = [
  { html: line("dim", "$ ", "txt", "pnpm test"), delay: 200 },
  { html: line("dim", "…", "txt", "running 14 test suites"), delay: 1400 },
  { html: line("dim", "$ ", "txt", "git add -A &amp;&amp; git commit -m \"fix: checkout\""), delay: 2600 },
  { html: line("dim", "[main 3e1a7c2]", "txt", "fix: checkout"), delay: 3400 },
  { html: line("dim", "$ ", "txt", "git push"), delay: 4200 },
  { html: spacer(), delay: 5000 },
  { html: line("dim", "06:00", "txt-muted", "…agent loop closed. move to next task"), delay: 6200 },
  { html: spacer(), delay: 7000 },
  { html: line("dim", "06:06", "fail", "GitHub Actions: 3 checks failed"), delay: 8400 },
  { html: line("fail-indent", "", "fail", "tsc: Cannot find module 'lodash'"), delay: 9000 },
  { html: line("fail-indent", "", "fail", "jest: 2 snapshots obsolete"), delay: 9600 },
  { html: spacer(), delay: 10400 },
  { html: line("dim", "06:08", "txt-muted", "human triages failure…"), delay: 11600 },
  { html: line("dim", "06:23", "fail", "hotfix commit pushed. 17 min of human time."), delay: 13200 },
];

const rightFrames: Frame[] = [
  { html: line("dim", "$ ", "txt", "pnpm test"), delay: 200 },
  { html: line("dim", "…", "txt", "running 14 test suites"), delay: 1400 },
  { html: line("dim", "$ ", "txt", "git add -A &amp;&amp; git commit -m \"fix: checkout\""), delay: 2600 },
  { html: spacer(), delay: 3000 },
  { html: line("gate-label", "klasp", "gate-running", "running gates…"), delay: 3200 },
  { html: line("gate-label", "klasp", "gate-fail", "FAIL  tsc · missing import"), delay: 4100 },
  { html: line("fail-indent", "", "fail", "src/lib/foo.ts:3 — Cannot find module 'lodash'"), delay: 4700 },
  { html: spacer(), delay: 5200 },
  { html: line("dim", "…", "txt-muted", "agent reads verdict. fixes import in same loop."), delay: 5600 },
  { html: spacer(), delay: 6600 },
  { html: line("dim", "$ ", "txt", "git add src/lib/foo.ts &amp;&amp; git commit -m \"fix: checkout\""), delay: 7000 },
  { html: spacer(), delay: 7400 },
  { html: line("gate-label", "klasp", "gate-running", "running gates…"), delay: 7600 },
  { html: line("gate-label", "klasp", "gate-ok", "PASS  tsc"), delay: 8500 },
  { html: line("gate-label", "klasp", "gate-ok", "PASS  jest"), delay: 9000 },
  { html: line("gate-label", "klasp", "gate-ok", "PASS  eslint"), delay: 9500 },
  { html: spacer(), delay: 10100 },
  { html: line("dim", "[main 9fa12b0]", "ok", "fix: checkout — committed clean"), delay: 10900 },
  { html: line("dim", "…", "ok", "agent loop closes. no human needed."), delay: 12300 },
];

function line(
  promptCls: string,
  promptTxt: string,
  msgCls: string,
  msgTxt: string,
): string {
  return `<div class="dline"><span class="dline-prompt ${promptCls}">${promptTxt}</span><span class="dline-msg ${msgCls}">${msgTxt}</span></div>`;
}

function spacer(): string {
  return `<div class="dline dline-spacer"></div>`;
}

let timers: ReturnType<typeof setTimeout>[] = [];

function clearTimers() {
  timers.forEach(clearTimeout);
  timers = [];
}

function run() {
  clearTimers();
  const left = document.getElementById("demoLeft");
  const right = document.getElementById("demoRight");
  if (!left || !right) return;
  left.innerHTML = "";
  right.innerHTML = "";

  leftFrames.forEach(({ html, delay }) => {
    timers.push(setTimeout(() => { left.insertAdjacentHTML("beforeend", html); }, delay));
  });

  rightFrames.forEach(({ html, delay }) => {
    timers.push(setTimeout(() => { right.insertAdjacentHTML("beforeend", html); }, delay));
  });

  // auto loop
  timers.push(setTimeout(run, LOOP_DELAY));
}

document.addEventListener("DOMContentLoaded", () => {
  run();
  document.getElementById("replayBtn")?.addEventListener("click", run);
});
</script>
