---
import Layout from "../layouts/Layout.astro";
import surfaces from "../data/surfaces.json";

// Single source of truth for the version number and capability matrix:
// src/data/surfaces.json, synced from the klasp repo's docs/surfaces.json via
// `node scripts/sync-surfaces.mjs`. Release-specific taglines stay editorial;
// the version NUMBER and the matrix cells are data-driven so they can't drift.
const KLASP_VERSION = surfaces.version;

const SHOWN = ["Claude Code", "Codex CLI", "Aider", "Cursor"];
const isYes = (name, cap) => {
  const s = surfaces.surfaces.find((x) => x.name === name);
  return (s?.cells?.[cap] ?? "—").startsWith("✓");
};
// Each row maps a display label to a canonical capability so every ✓ traces to
// surfaces.json. "Managed config" is site-only presentation.
const MANAGED_CONFIG = {
  "Claude Code": ".claude/settings.json",
  "Codex CLI": "AGENTS.md",
  Aider: ".aider.conf.yml",
  Cursor: null,
};
const CAP_ROWS = [
  { label: "Pre-commit gate", cap: "Commit gate" },
  { label: "Push gate", cap: "Push gate" },
  { label: "Idempotent install / uninstall", cap: "Install" },
  { label: "Conflict detection", cap: "Conflict handling" },
  { label: "Captured-session test", cap: "Captured-session test" },
];
---

<Layout
  title="klasp — block AI agents on the same gates as your humans"
  description={`klasp gates AI coding agents locally on your existing quality checks — before the agent's loop closes. v${KLASP_VERSION}: zero-setup klasp demo, hook-conflict detection, and a subprocess plugin protocol.`}
>
  <header class="nav">
    <div class="container nav-row">
      <a href="/" class="brand">klasp</a>
      <ul class="nav-links">
        <li><a href="https://github.com/klasp-dev/klasp">GitHub</a></li>
        <li><a href="https://github.com/klasp-dev/klasp/blob/main/docs/setup.md">Docs</a></li>
        <li><a href="https://github.com/klasp-dev/klasp/releases">Releases</a></li>
      </ul>
    </div>
  </header>

  <main>
    <!-- ── 1. HERO ─────────────────────────────────────── -->
    <section class="hero">
      <div class="container">
        <a class="eyebrow" href={`https://github.com/klasp-dev/klasp/releases/tag/v${KLASP_VERSION}`}
          ><span class="dot"></span>v{KLASP_VERSION} — demo · conflict-aware · plugins</a
        >
        <h1 class="h1">
          AI agents commit broken code.
          <em>klasp stops them locally</em> — before the loop closes.
        </h1>
        <p class="lede">
          klasp blocks AI coding agents on your existing quality gates — no rewrites, no
          migration. See it work in one command, no repo required.
        </p>
        <p class="sub-lede">
          <code>klasp demo</code> shows the whole story; <code>klasp setup</code> wires it into
          your repo from <code>git init</code> to green doctor.
        </p>
        <div class="cta-row">
          <span class="install-snippet" data-copy="cargo install klasp &amp;&amp; klasp demo">
            <span class="prompt">$</span><span>cargo install klasp &amp;&amp; klasp demo</span>
            <span class="copy-hint" aria-hidden="true">copy</span>
          </span>
          <a class="btn-ghost" href="https://github.com/klasp-dev/klasp">
            View on GitHub →
          </a>
        </div>
      </div>
    </section>

    <!-- ── 2. MINI-DEMO ───────────────────────────────── -->
    <section class="section demo-section">
      <div class="container">
        <p class="section-label">Live demo · <code>klasp demo</code></p>
        <h2 class="section-title">Same agent. Same task. One difference.</h2>
        <p class="section-sub">
          This is what <code>klasp demo</code> replays in your terminal — a deterministic,
          pre-recorded gate session. No repo to enrol, nothing to configure.
        </p>

        <div class="demo-grid" id="demoGrid">
          <!-- LEFT: without klasp -->
          <div class="demo-panel demo-panel--bad">
            <div class="demo-panel-header">
              <span class="demo-panel-label demo-label--bad">without klasp</span>
              <span class="demo-panel-pid">agent-session · pid 8821</span>
            </div>
            <div class="demo-panel-body" id="demoLeft"></div>
          </div>

          <!-- RIGHT: with klasp -->
          <div class="demo-panel demo-panel--good">
            <div class="demo-panel-header">
              <span class="demo-panel-label demo-label--good">with klasp</span>
              <span class="demo-panel-pid">agent-session · pid 8822</span>
            </div>
            <div class="demo-panel-body" id="demoRight"></div>
          </div>
        </div>

        <div class="demo-controls">
          <button class="btn-replay" id="replayBtn" type="button">Replay</button>
          <span class="demo-hint">auto-loops every 36 s</span>
        </div>
      </div>
    </section>

    <!-- ── 3. TRUST STRIP ─────────────────────────────── -->
    <section class="section trust-section">
      <div class="container">
        <p class="section-label">No surprises</p>
        <h2 class="section-title">A gate you can trust on the commit path.</h2>
        <div class="trust-grid">
          <div class="trust-card">
            <h4><span class="tick">✓</span> Fail-open by default</h4>
            <p>
              A parse error or version skew degrades to <em>allow</em>, with a notice on the
              surface — klasp never silently wedges your commits.
            </p>
          </div>
          <div class="trust-card">
            <h4><span class="tick">✓</span> Won't clobber your hooks</h4>
            <p>
              v{KLASP_VERSION} fingerprints husky, lefthook, and pre-commit and skips with a warning
              instead of overwriting. <code>klasp init --adopt</code> mirrors what you already
              run.
            </p>
          </div>
          <div class="trust-card">
            <h4><span class="tick">✓</span> klasp gates klasp</h4>
            <p>
              The repo blocks its own agents on <code>cargo check</code> / clippy / test via a
              real
              <a href="https://github.com/klasp-dev/klasp/blob/main/klasp.toml">klasp.toml</a> —
              and so does this site.
            </p>
          </div>
          <div class="trust-card">
            <h4><span class="tick">✓</span> Proven, not promised</h4>
            <p>
              Every green cell in the agent matrix below is backed by a committed
              captured-session test, not a marketing claim.
            </p>
          </div>
          <div class="trust-card">
            <h4><span class="tick">✓</span> Honest about pre-1.0</h4>
            <p>
              Config and plugin schemas are versioned and stabilise at v1.0; breaking changes
              land only at minor boundaries, with migration notes. See the
              <a href="https://github.com/klasp-dev/klasp/blob/main/SECURITY.md">security model</a>.
            </p>
          </div>
          <div class="trust-card">
            <h4><span class="tick">✓</span> Apache-2.0, one Rust binary</h4>
            <p>cargo / npm / pip. No telemetry, no account, no server in the loop.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 4. QUICK INSTALL ───────────────────────────── -->
    <section class="section">
      <div class="container">
        <p class="section-label">Install</p>
        <h2 class="section-title">Pick your package manager.</h2>
        <div class="install-grid">
          <div class="install-card">
            <h4>cargo (rust)</h4>
            <pre><span class="prompt">$ </span>cargo install klasp</pre>
          </div>
          <div class="install-card">
            <h4>npm</h4>
            <pre><span class="prompt">$ </span>npm i -g @klasp-dev/klasp</pre>
          </div>
          <div class="install-card">
            <h4>pip (python)</h4>
            <pre><span class="prompt">$ </span>pip install klasp</pre>
          </div>
        </div>
        <div class="setup-callout">
          <span class="setup-callout-label">then</span>
          <span class="install-snippet install-snippet--lg">
            <span class="prompt">$</span><span>klasp setup</span>
          </span>
        </div>
      </div>
    </section>

    <!-- existing sections preserved below ──────────────── -->
    <section class="section">
      <div class="container">
        <p class="section-label">Use case · overnight autonomy</p>
        <h2 class="section-title">Ship while you sleep. Wake up to PRs, not panic.</h2>
        <p class="lede" style="margin-bottom: 32px;">
          Autonomous agents need a deterministic <em>done</em> signal. Without one, an
          overnight run drifts: retry loops, exhausted context, force-pushed broken
          commits. klasp <em>is</em> that signal — every iteration ends in a clean
          pass / fail with structured findings.
        </p>

        <div class="usecase-grid">
          <article class="term term-bad" aria-label="Without klasp">
            <div class="term-header">
              <span class="label">Without klasp</span>
              <span class="pid">overnight-run · pid 4471</span>
            </div>
            <div class="term-body">
              <div class="log"><span class="t">23:42</span><span class="ic-arrow">▸</span><span class="msg">agent: implement <strong>checkout flow</strong></span></div>
              <div class="log"><span class="t">00:15</span><span class="ic-fail">✗</span><span class="msg">tests fail · agent guesses, retries with different approach</span></div>
              <div class="log"><span class="t">01:33</span><span class="ic-fail">✗</span><span class="msg">lint errors · agent rewrites unrelated module</span></div>
              <div class="log"><span class="t">02:50</span><span class="ic-fail">✗</span><span class="msg">stuck in test/lint loop · context window exhausted</span></div>
              <div class="log"><span class="t">04:12</span><span class="ic-fail">✗</span><span class="msg">agent gives up <span class="err">→ force-pushes broken code</span></span></div>
              <hr class="term-divider" />
              <div class="log epic"><span class="t">07:00</span><span class="ic-fail">⨯</span><span class="msg"><strong>main is red. 47 failed CI runs. 6h of compute burned.</strong></span></div>
            </div>
          </article>

          <article class="term term-good" aria-label="With klasp">
            <div class="term-header">
              <span class="label">With klasp</span>
              <span class="pid">overnight-run · pid 4472</span>
            </div>
            <div class="term-body">
              <div class="log"><span class="t">23:42</span><span class="ic-arrow">▸</span><span class="msg">agent: implement <strong>checkout flow</strong></span></div>
              <div class="log"><span class="t">23:58</span><span class="ic-warn">●</span><span class="msg"><span class="gate">klasp:format</span> ✗ → 3 lines · agent fixes</span></div>
              <div class="log"><span class="t">00:14</span><span class="ic-ok">✓</span><span class="msg"><span class="gate">format · lint</span> · agent advances</span></div>
              <div class="log"><span class="t">00:47</span><span class="ic-warn">●</span><span class="msg"><span class="gate">klasp:test</span> ✗ → <code>test_total::charges_tax</code> · agent investigates</span></div>
              <div class="log"><span class="t">01:22</span><span class="ic-ok">✓</span><span class="msg"><span class="gate">all gates</span> · commit · open PR <strong>#142</strong></span></div>
              <div class="log"><span class="t">01:25</span><span class="ic-arrow">▸</span><span class="msg">agent: implement <strong>refund handler</strong></span></div>
              <hr class="term-divider" />
              <div class="log epic"><span class="t">07:00</span><span class="ic-ok">✓</span><span class="msg"><strong>4 clean PRs in your queue. All green CI. Ready to review.</strong></span></div>
            </div>
          </article>
        </div>

        <div class="usecase-why">
          <div class="item">
            <h4>01 — deterministic done</h4>
            <p>
              Exit codes are unambiguous. Agents stop guessing whether they're finished —
              the gate said zero, the gate said one. No drift, no panic loops.
            </p>
          </div>
          <div class="item">
            <h4>02 — structured findings</h4>
            <p>
              When a gate fails, klasp surfaces line-numbered diagnostics from
              <code>cargo</code>, <code>pytest</code>, your linter — so the agent fixes
              the actual error, not a hallucinated symptom.
            </p>
          </div>
          <div class="item">
            <h4>03 — bounded context</h4>
            <p>
              Tight pass / fail loops mean each iteration burns a few hundred tokens, not
              tens of thousands. Overnight runs stay inside their context window.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="section-label">Why klasp</p>
        <h2 class="section-title">One config. Same gates. Both audiences.</h2>
        <div class="why-grid">
          <article class="why-card">
            <h3><span class="num">01</span> Stop bad PRs at the source</h3>
            <p>
              Agents can't merge what they can't pass. klasp wires your existing fmt /
              lint / test commands into deterministic exit-code gates the agent has to
              clear before it commits.
            </p>
          </article>
          <article class="why-card">
            <h3><span class="num">02</span> One config, both audiences</h3>
            <p>
              <code>klasp.toml</code> is the single source of truth. The same gate that
              guards your pre-commit hook guards the agent loop — no second config to
              drift out of sync.
            </p>
          </article>
          <article class="why-card">
            <h3><span class="num">03</span> Three surfaces, plugin protocol for the rest</h3>
            <p>
              First-class for Claude Code, Codex CLI, and Aider. Managed
              <code>.claude/settings.json</code> / <code>AGENTS.md</code> /
              <code>.aider.conf.yml</code> blocks installed idempotently, with
              conflict detection and clean uninstall. New surfaces ship via the
              v0 plugin protocol — fork the reference plugin and you're done.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="section-label">Recipes</p>
        <h2 class="section-title">Typed recipes for the gates you already run.</h2>
        <div class="code-block">
          <div class="code-header">
            <span class="dots"><span></span><span></span><span></span></span>
            <span class="file">klasp.toml</span>
          </div>
          <pre class="code-body"><span class="tok-comment"># fmt — wraps an existing pre-commit hook</span>
<span class="tok-section">[[checks]]</span>
<span class="tok-key">name</span>    = <span class="tok-str">"format"</span>
<span class="tok-key">type</span>    = <span class="tok-str">"pre_commit"</span>
<span class="tok-key">hook_id</span> = <span class="tok-str">"rustfmt"</span>

<span class="tok-comment"># lint — fallow groups multiple checks under one verdict</span>
<span class="tok-section">[[checks]]</span>
<span class="tok-key">name</span> = <span class="tok-str">"lint"</span>
<span class="tok-key">type</span> = <span class="tok-str">"fallow"</span>

<span class="tok-comment"># test — pytest with JUnit-XML diagnostics surfaced to the agent</span>
<span class="tok-section">[[checks]]</span>
<span class="tok-key">name</span>      = <span class="tok-str">"test"</span>
<span class="tok-key">type</span>      = <span class="tok-str">"pytest"</span>
<span class="tok-key">junit_xml</span> = <span class="tok-bool">true</span>

<span class="tok-comment"># build — cargo with structured compiler diagnostics</span>
<span class="tok-section">[[checks]]</span>
<span class="tok-key">name</span>       = <span class="tok-str">"build"</span>
<span class="tok-key">type</span>       = <span class="tok-str">"cargo"</span>
<span class="tok-key">subcommand</span> = <span class="tok-str">"check"</span>
</pre>
        </div>
      </div>
    </section>

    <!-- ── BUILDER LANE ─────────────────────────────────── -->
    <section class="section builder-section">
      <div class="container">
        <p class="section-label">For builders</p>
        <h2 class="section-title">A machine contract, not just a hook.</h2>
        <p class="section-sub">
          klasp is the deterministic adjudicator your orchestrator polls. <code>klasp gate</code>
          returns a versioned verdict — the same contract drives the agent surface, CI, plugins,
          and autonomous runs.
        </p>

        <div class="builder-grid">
          <div class="code-block">
            <div class="code-header">
              <span class="dots"><span></span><span></span><span></span></span>
              <span class="file">klasp gate --format json</span>
            </div>
            <pre class="code-body"><span class="tok-key">$</span> klasp gate --format json
<span class="tok-comment"># exit 0 = pass · exit 2 = fail (block) · stable, versioned</span>
&#123;
  <span class="tok-key">"output_schema_version"</span>: <span class="tok-bool">1</span>,
  <span class="tok-key">"verdict"</span>: <span class="tok-str">"fail"</span>,
  <span class="tok-key">"checks"</span>: [
    &#123;
      <span class="tok-key">"name"</span>: <span class="tok-str">"test"</span>,
      <span class="tok-key">"verdict"</span>: <span class="tok-str">"fail"</span>,
      <span class="tok-key">"findings"</span>: [
        &#123;
          <span class="tok-key">"severity"</span>: <span class="tok-str">"error"</span>,
          <span class="tok-key">"file"</span>: <span class="tok-str">"src/lib.rs"</span>,
          <span class="tok-key">"line"</span>: <span class="tok-bool">42</span>,
          <span class="tok-key">"rule"</span>: <span class="tok-str">"test_total::charges_tax"</span>
        &#125;
      ]
    &#125;
  ]
&#125;
</pre>
          </div>

          <div class="builder-points">
            <div class="builder-point">
              <h4>Structured output</h4>
              <p>
                JSON, plus <code>--format junit</code> and <code>--format sarif</code> — land agent
                verdicts in CI summaries and GitHub code-scanning.
                <a href="https://github.com/klasp-dev/klasp/blob/main/docs/output-schema.md">Schema →</a>
              </p>
            </div>
            <div class="builder-point">
              <h4>Subprocess plugin protocol</h4>
              <p>
                JSON over stdin/stdout, <code>--describe</code> / <code>--gate</code>. Add a custom
                check or surface and klasp runs it.
                <a href="https://github.com/klasp-dev/klasp/blob/main/docs/plugin-protocol.md">v0 protocol →</a>
              </p>
            </div>
            <div class="builder-point">
              <h4>Orchestrator-ready <span class="ver-pill">v{KLASP_VERSION}</span></h4>
              <p>
                The <code>klasp-plugin-agentic-flow</code> reference gates push on
                <code>.agentic-flow/</code> step receipts — resume from the earliest stale step.
                <a href="https://github.com/klasp-dev/klasp/tree/main/examples/klasp-plugin-agentic-flow">Reference plugin →</a>
              </p>
            </div>
            <div class="builder-point">
              <h4>Parallel &amp; fail-open</h4>
              <p>
                rayon work-stealing across checks; infra errors degrade to <em>warn</em>, never a
                spurious block. Protocol is experimental v0 — pin the schema, detect drift.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="section-label">Agents</p>
        <h2 class="section-title">First-class support for the agents you ship with.</h2>
        <table class="matrix">
          <thead>
            <tr>
              <th class="feature">Capability</th>
              {SHOWN.map((s) => <th>{s}</th>)}
            </tr>
          </thead>
          <tbody>
            {CAP_ROWS.slice(0, 2).map((r) => (
              <tr>
                <td class="feature">{r.label}</td>
                {SHOWN.map((s) =>
                  isYes(s, r.cap) ? (
                    <td class="yes">✓</td>
                  ) : (
                    <td class="pending">—</td>
                  ),
                )}
              </tr>
            ))}
            <tr>
              <td class="feature">Managed config</td>
              {SHOWN.map((s) =>
                MANAGED_CONFIG[s] ? (
                  <td><code>{MANAGED_CONFIG[s]}</code></td>
                ) : (
                  <td class="pending">—</td>
                ),
              )}
            </tr>
            {CAP_ROWS.slice(2).map((r) => (
              <tr>
                <td class="feature">{r.label}</td>
                {SHOWN.map((s) =>
                  isYes(s, r.cap) ? (
                    <td class="yes">✓</td>
                  ) : (
                    <td class="pending">—</td>
                  ),
                )}
              </tr>
            ))}
          </tbody>
        </table>
        <p class="matrix-note">
          Cursor's hook surface is still beta as of Cursor 3.3 with open
          correctness bugs — deferred to v0.3.x or v1.0. Need a different
          agent? Ship a plugin: two reference plugins now —
          <a href="https://github.com/klasp-dev/klasp/tree/main/examples/klasp-plugin-pre-commit">pre-commit</a>
          and
          <a href="https://github.com/klasp-dev/klasp/tree/main/examples/klasp-plugin-agentic-flow">agentic-flow</a> —
          plus the
          <a href="https://github.com/klasp-dev/klasp/blob/main/docs/plugin-protocol.md">v0 protocol spec</a>.
        </p>
      </div>
    </section>
  </main>

  <!-- ── 5. FOOTER ─────────────────────────────────────── -->
  <footer class="footer">
    <div class="container footer-row">
      <span>klasp · v{KLASP_VERSION} · Apache-2.0</span>
      <ul class="footer-links">
        <li><a href="https://github.com/klasp-dev/klasp">GitHub</a></li>
        <li><a href="https://github.com/klasp-dev/klasp/blob/main/docs/setup.md">Docs</a></li>
        <li><a href={`https://github.com/klasp-dev/klasp/releases/tag/v${KLASP_VERSION}`}>v{KLASP_VERSION} release</a></li>
        <li><a href="https://github.com/klasp-dev/klasp/issues">Issues</a></li>
        <li><a href="https://github.com/klasp-dev/klasp/blob/main/LICENSE">License</a></li>
      </ul>
    </div>
  </footer>
</Layout>

<script>
// ── Mini-demo animation ──────────────────────────────────────────
// All timing in milliseconds.
// FRAME = one "typed line" appearance.  Lines are pre-built HTML strings —
// no character-by-character typing to keep the JS under 150 lines.

const LOOP_DELAY = 36_000; // ms before auto-restart

type Frame = { html: string; delay: number };

// LEFT — without klasp.
// Agent commits broken code, CI fails, agent retries blindly, fails again,
// retries again, fails again — wedged retry loop, no learning, no human.
// This is what happens when the only feedback signal is post-merge CI.
const leftFrames: Frame[] = [
  { html: line("dim", "$ ", "txt", "pnpm test"), delay: 200 },
  { html: line("dim", "…", "txt", "14 suites pass"), delay: 1400 },
  { html: line("dim", "$ ", "txt", "git commit -m \"fix: checkout\""), delay: 2400 },
  { html: line("dim", "$ ", "txt", "git push"), delay: 3200 },
  { html: spacer(), delay: 4000 },
  { html: line("dim", "06:00", "txt-muted", "…loop closes. agent picks next task"), delay: 5200 },
  { html: spacer(), delay: 6200 },
  { html: line("dim", "06:06", "fail", "GitHub Actions: 3 checks failed"), delay: 7600 },
  { html: line("fail-indent", "", "fail", "tsc: Cannot find module 'lodash'"), delay: 8200 },
  { html: line("fail-indent", "", "fail", "jest: 2 snapshots obsolete"), delay: 8800 },
  { html: spacer(), delay: 9600 },
  { html: line("dim", "06:09", "txt-muted", "agent re-opens PR. regenerates patch."), delay: 10800 },
  { html: line("dim", "$ ", "txt", "git push --force-with-lease"), delay: 12000 },
  { html: spacer(), delay: 12800 },
  { html: line("dim", "06:17", "fail", "GitHub Actions: 4 checks failed"), delay: 13800 },
  { html: line("fail-indent", "", "fail", "tsc: still missing 'lodash'"), delay: 14400 },
  { html: line("fail-indent", "", "fail", "eslint: 'foo' redeclared"), delay: 15000 },
  { html: spacer(), delay: 15800 },
  { html: line("dim", "06:21", "txt-muted", "agent retries again. push #3."), delay: 16800 },
  { html: line("dim", "06:28", "fail", "GitHub Actions: 5 checks failed"), delay: 18200 },
  { html: spacer(), delay: 19000 },
  { html: line("dim", "⚠", "fail", "retry loop wedged. CI minutes burning."), delay: 20200 },
  { html: line("dim", "⚠", "fail", "PR rotting. someone has to break the loop."), delay: 21400 },
];

// RIGHT — with klasp.
// Same agent, same broken code. klasp gates locally; agent reads structured
// verdict, fixes in the same loop, commits clean — then keeps going.
// The wedge: the agent is *productive* instead of stuck.
const rightFrames: Frame[] = [
  { html: line("dim", "$ ", "txt", "pnpm test"), delay: 200 },
  { html: line("dim", "…", "txt", "14 suites pass"), delay: 1400 },
  { html: line("dim", "$ ", "txt", "git commit -m \"fix: checkout\""), delay: 2400 },
  { html: spacer(), delay: 2800 },
  { html: line("gate-label", "klasp", "gate-running", "running gates…"), delay: 3000 },
  { html: line("gate-label", "klasp", "gate-fail", "FAIL  tsc · missing import"), delay: 3900 },
  { html: line("fail-indent", "", "fail", "src/lib/foo.ts:3 — Cannot find module 'lodash'"), delay: 4500 },
  { html: spacer(), delay: 5000 },
  { html: line("dim", "…", "txt-muted", "agent reads verdict. fixes import in same loop."), delay: 5400 },
  { html: spacer(), delay: 6300 },
  { html: line("dim", "$ ", "txt", "git commit -m \"fix: checkout\""), delay: 6700 },
  { html: spacer(), delay: 7000 },
  { html: line("gate-label", "klasp", "gate-running", "running gates…"), delay: 7200 },
  { html: line("gate-label", "klasp", "gate-ok", "PASS  tsc"), delay: 8100 },
  { html: line("gate-label", "klasp", "gate-ok", "PASS  jest"), delay: 8600 },
  { html: line("gate-label", "klasp", "gate-ok", "PASS  eslint"), delay: 9100 },
  { html: spacer(), delay: 9700 },
  { html: line("dim", "[main 9fa12b0]", "ok", "fix: checkout — committed clean"), delay: 10500 },
  { html: spacer(), delay: 11400 },
  { html: line("dim", "…", "txt-muted", "agent picks next ticket from queue"), delay: 12200 },
  { html: line("dim", "$ ", "txt", "git checkout -b feat/inventory-cache"), delay: 13400 },
  { html: line("dim", "$ ", "txt", "git commit -m \"feat: inventory cache\""), delay: 14600 },
  { html: spacer(), delay: 15200 },
  { html: line("gate-label", "klasp", "gate-ok", "PASS  tsc · jest · eslint"), delay: 15600 },
  { html: line("dim", "[main 7d1f9a2]", "ok", "feat: inventory cache — committed clean"), delay: 16800 },
  { html: spacer(), delay: 17800 },
  { html: line("dim", "✓", "ok", "agent shipping continuously."), delay: 18800 },
  { html: line("dim", "✓", "ok", "no human in the loop."), delay: 20000 },
];

function line(
  promptCls: string,
  promptTxt: string,
  msgCls: string,
  msgTxt: string,
): string {
  return `<div class="dline"><span class="dline-prompt ${promptCls}">${promptTxt}</span><span class="dline-msg ${msgCls}">${msgTxt}</span></div>`;
}

function spacer(): string {
  return `<div class="dline dline-spacer"></div>`;
}

let timers: ReturnType<typeof setTimeout>[] = [];

function clearTimers() {
  timers.forEach(clearTimeout);
  timers = [];
}

function run() {
  clearTimers();
  const left = document.getElementById("demoLeft");
  const right = document.getElementById("demoRight");
  if (!left || !right) return;
  left.innerHTML = "";
  right.innerHTML = "";

  leftFrames.forEach(({ html, delay }) => {
    timers.push(setTimeout(() => { left.insertAdjacentHTML("beforeend", html); }, delay));
  });

  rightFrames.forEach(({ html, delay }) => {
    timers.push(setTimeout(() => { right.insertAdjacentHTML("beforeend", html); }, delay));
  });

  // auto loop
  timers.push(setTimeout(run, LOOP_DELAY));
}

document.addEventListener("DOMContentLoaded", () => {
  run();
  document.getElementById("replayBtn")?.addEventListener("click", run);
});
</script>

<script>
// ── Bold motion: scroll-reveal + copy-to-clipboard ──────────────
const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

// Copy-to-clipboard on the hero install snippet.
document.querySelectorAll<HTMLElement>(".install-snippet[data-copy]").forEach((el) => {
  el.addEventListener("click", async () => {
    const text = el.dataset.copy ?? "";
    try {
      await navigator.clipboard.writeText(text);
      const hint = el.querySelector(".copy-hint");
      if (hint) {
        const prev = hint.textContent;
        hint.textContent = "copied ✓";
        el.classList.add("copied");
        setTimeout(() => {
          hint.textContent = prev;
          el.classList.remove("copied");
        }, 1600);
      }
    } catch {
      /* clipboard unavailable — no-op */
    }
  });
});

// Scroll-reveal — only when motion is allowed and the API exists, so no-JS and
// reduced-motion users always see fully-rendered content (no hidden state).
if (!reduceMotion && "IntersectionObserver" in window) {
  document.body.classList.add("anim-ready");
  const targets = document.querySelectorAll(
    ".hero .h1, .hero .lede, .hero .sub-lede, .hero .cta-row, .section-title, .section-sub, .trust-card, .builder-point, .builder-section .code-block, .why-card, .install-card, .setup-callout, .usecase-grid, .usecase-why .item, .matrix, .matrix-note, .code-block, .demo-grid, .demo-controls",
  );
  const io = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).classList.add("is-visible");
          obs.unobserve(entry.target);
        }
      });
    },
    { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
  );
  targets.forEach((t, i) => {
    t.classList.add("reveal-on-scroll");
    (t as HTMLElement).style.transitionDelay = `${Math.min(i % 6, 5) * 50}ms`;
    io.observe(t);
  });
}
</script>
